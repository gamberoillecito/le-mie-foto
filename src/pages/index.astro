---
import { Image } from "astro:assets";
import { readFile } from "node:fs/promises";
import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../images/*.{jpg,jpeg,png,webp}",
);

// Format: yyyymmdd[(id)][_title_separated_by_underscores][-tags-separated-by-dashes]
type ParsedFormat = {
  date: string;
  id?: string;
  title?: string;
  tags: string[];
  extension: string;
};

function formatDate(value: string): string {
  const year = value.slice(0, 4);
  const month = value.slice(4, 6);
  const day = value.slice(6, 8);

  return `${day}-${month}-${year}`;
}

function parsePath(value: string): ParsedFormat {
  // Supports both "/" and "\" path separators
  const filename = value.split(/[\\/]/).pop();

  if (!filename) {
    throw new Error(`Invalid path: ${value}`);
  }

  const match = filename.match(
    /^(?<date>\d{8})(?:\((?<id>[^)]+)\))?(?:_(?<title>[A-Za-z0-9_]+))?(?:-(?<tags>[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*))?\.(?<extension>[A-Za-z0-9]+)$/,
  );

  if (!match?.groups) {
    throw new Error(`Invalid filename format: ${filename}`);
  }

  const { date, id, title, tags, extension } = match.groups;

  return {
    date: formatDate(date),
    ...(id !== undefined && { id }),
    ...(title !== undefined && {
      title: title.replaceAll("_", " "),
    }),
    tags: tags ? tags.split("-") : [],
    extension,
  };
}
---

<BaseLayout
  title="Le Mie Foto"
  description="A minimal, single-page photo gallery."
>
  <section class="justified-gallery" id="photoswipe">
    {
      Object.entries(images).reverse().map(async ([_path, image], index) => {
        const { default: imageData } = await image();
        // const exif = ExifReader.load(
        //   await readFile(new URL(_path, import.meta.url)),
        // );
        const imageInfo = parsePath(_path);
        return (
          <a
            style={`--width: ${imageData.width}; --height: ${imageData.height};`}
            href={imageData.src}
            target="_blank"
            data-fancybox="gallery"
            data-caption={(imageInfo.title ?? "") + " " + imageInfo.date}
            data-caption-value={(imageInfo.title ?? "") + " " + imageInfo.date}
          >
            <Image
              format="webp"
              src={imageData}
              alt=""
              height={400}
              loading={index < 20 ? "eager" : "lazy"}
            />
            
          </a>
        );
      })
    }
  </section>
</BaseLayout>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";
import { undefined } from "astro:schema";

  let showCaptions = true;
  const galleryLinks = document.querySelectorAll<HTMLAnchorElement>(
    "[data-fancybox='gallery']",
  );

  function updateCaptions() {
    let captions = document.getElementsByClassName("f-caption");
    for (let el of captions){
      
      // (el as HTMLElement).style.scale = showCaptions ? "0" : "1";
      (el as HTMLElement).style.display = showCaptions ? "none" : "block";
    }
    showCaptions = showCaptions ? false : true;
  }


  Fancybox.bind("[data-fancybox]", {
    theme: "light",
    mainStyle: {
      "--f-button-width": "44px",
      "--f-button-height": "44px",
      "--f-button-border-radius": "50%",
      "--f-toolbar-padding": "16px",
    },
    Carousel: {
      Arrows: false,
      Toolbar: {
        items: {
        facebook: {
          tpl: '<button class="f-button"><svg><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></button>',
          click: () => {
            updateCaptions();
          },
        },
      },
        display: {
          left: [],
          middle: [],
          right: ["fullscreen", "facebook"],
        },
      },
      transition: "fade",
      Zoomable: {
        Panzoom: {
          panMode: "mousemove",
          protected: true,
        },
    },
    },
  });
</script>

<style>
  .justified-gallery {
    --padding: max(2.5vw, 12px);
    --space: max(2.5vw, 12px);
    --min-height: clamp(200px, 20vw, 400px);

    padding: var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);

    a {
      flex-grow: calc(var(--width) * (100000 / var(--height)));
      flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
      aspect-ratio: var(--width) / var(--height);
      overflow: hidden;
      opacity: 1;
      transition: all 0.05s ease-in-out;
    }

    a img {
      display: block;
      object-fit: cover;
      height: 100%;
      width: 100%;
      transform: scale(1.01);
    }

    a:focus-visible {
      /* outline: 3px solid var(--outline);
      outline-offset: 2px; */
      transform: scale(1.05);
      z-index: 1;
      border-radius: 2px;
      /* box-shadow: 0 2px 4px 2px rgba(0, 0, 0, 0.1); */
    }

    a.hidden {
      transition: opacity 0.4s ease-in-out;
      opacity: 0;
    }

    &::after {
      content: " ";
      flex-grow: 1000000000;
    }
  }

</style>
